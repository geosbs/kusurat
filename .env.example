# Local (Next.js on the machine, Postgres in Docker):
#   docker compose up -d postgres
#   npx prisma migrate deploy
#   npm run dev
# Then open http://localhost:3000
#
# Full Docker stack:
#   docker compose up --build
# Then open http://localhost:2010

# Production (Docker):
#   NEXT_PUBLIC_SITE_URL="https://geosbau.at"
# Local Next.js still uses DATABASE_URL against Docker Postgres.

DATABASE_URL="postgresql://geosbau:geosbau@localhost:5433/geosbau?schema=public"
NEXT_PUBLIC_SITE_URL="https://geosbau.at"
POSTGRES_PASSWORD="geosbau"
